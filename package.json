{
  "name": "signalk-wyoming",
  "version": "0.2.1",
  "description": "Voice assistant orchestrator for Signal K — voice commands in, spoken announcements out.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && webpack",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "prepare": "husky || true",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version",
    "prepublishOnly": "npm run build && npm test"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,css,html}": "prettier --write"
  },
  "keywords": [
    "wyoming",
    "voice",
    "tts",
    "stt",
    "marine",
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-webapp",
    "signalk-category-utility"
  ],
  "author": "hoeken",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/signalk-wyoming.git"
  },
  "signalk": {
    "displayName": "Voice (Wyoming)",
    "requires": [
      "signalk-container"
    ],
    "recommends": [
      "signalk-piper",
      "signalk-whisper",
      "signalk-openwakeword"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "signalk-container-helper": "^0.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.30.0",
    "@types/node": "^24.0.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
